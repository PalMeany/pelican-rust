#!/usr/bin/env bash
# Run cargo inside the Linux dev container: in the lima VM "pelican" on macOS (the host cannot
# link: Xcode license not accepted — see QUESTIONS.md Q2), with the local Docker on Linux.
#
#   scripts/cargo build | test | clippy ...      (same args as cargo)
#
# The repo is mounted at the same absolute path, target dir and registry live
# in docker volumes. The container joins the difftest compose network when it
# exists, so tests can reach mariadb/postgres/panel-orig by service name.
# Env vars PELICAN_*, DB_*, RUST_LOG, RUST_BACKTRACE, TEST_* are forwarded.
# PELICAN_NET_ALIAS=<name> adds a DNS alias on the difftest network (mock Wings).
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/host.sh
source "$REPO/scripts/lib/host.sh"
NET="${PELICAN_NET:-pelican-difftest-main_default}"
DATA="$(cd "$REPO/.." && pwd)/.difftest"
# PELICAN_NET picks the difftest network; PELICAN_TARGET_VOLUME separates target dirs of parallel runs.
# Default volume: one per checkout. Cargo hashes path crates relative to the workspace root, so two
# checkouts sharing a target dir overwrite each other's rlibs (worktree builds broke main builds).
# The main checkout shares its volume with `scripts/difftest` (env "main").
case "$REPO" in
  */.worktrees/*) TARGET_DEFAULT="pelican-rs-target-${REPO##*/.worktrees/}" ;;
  *) TARGET_DEFAULT="pelican-rs-target-main" ;;
esac
TARGET_DEFAULT="${TARGET_DEFAULT//\//-}"

# Forward with explicit values: `limactl shell` does not carry the host environment into the VM.
# PELICAN_CPUSET applies to the container (scripts/lib/host.sh).
envs=()
while IFS='=' read -r k _; do
  case "$k" in PELICAN_*|DB_*|RUST_LOG|RUST_BACKTRACE|TEST_*|CARGO_TERM_COLOR) envs+=(-e "$(printf %q "$k=${!k}")");; esac
done < <(env)

tty=()
[[ -t 0 && -t 1 ]] && tty=(-t)

on_host sh -c '
  net=""
  docker network inspect '"$NET"' >/dev/null 2>&1 && net="--network '"$NET"'"
  alias=""
  sock=""
  # Rootless Docker in the VM, the system socket on a Linux host.
  if [ "'"${PELICAN_DOCKER_SOCK:-}"'" = 1 ]; then
    for s in "${XDG_RUNTIME_DIR:-/nonexistent}/docker.sock" /var/run/docker.sock; do
      [ -S "$s" ] && { sock="-v $s:/var/run/docker.sock"; break; }
    done
  fi
  [ -n "'"${PELICAN_NET_ALIAS:-}"'" ] && [ -n "$net" ] && alias="--network-alias '"${PELICAN_NET_ALIAS:-}"'"
  exec docker run --rm -i '"${tty[*]:-}"' '"$(cpu_opts)"' $net $alias $sock \
    -v "'"$REPO"'":"'"$REPO"'" -v "'"$DATA"'":"'"$DATA"'" -w "$PWD" \
    -v '"${PELICAN_TARGET_VOLUME:-$TARGET_DEFAULT}"':/target -v pelican-rs-registry:/usr/local/cargo/registry \
    '"${envs[*]:-}"' "$@"' sh pelican-rs-dev cargo "$@"
